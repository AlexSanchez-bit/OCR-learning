                  "include_metrics": ["cpu_usage", "memory_pressure", "disk_iops"],
                  "thresholds": {
                    "alert_on": [
                      {
                        "metric": "cpu_usage",
                        "condition": "gt",
                        "value": 85,
                        "duration_minutes": 5,
                        "escalation": {
                          "level_1": "slack-alert-channel",
                          "level_2": {
                            "pagerduty_service_key": "pd-service-key-888",
                            "auto_remediate": {
                              "enabled": true,
                              "action": "scale_out",
                              "max_instances": 10
                            }
                          }
